    {
      "no": 5,
      "title": "Hostile Interviews",
      "sections": [
        {
          "no": 11,
          "title": "Resistance Management",
          "anchor": "11-resistance-management",
          "subs": [],
          "items": [
            {
              "t": "Counter-interrogation Training / 훈련된 피면담자가 따르는 대응 교범의 구조"
            },
            {
              "t": "No-comment Interview / 묵비 대응 상황에서의 면담 운용"
            },
            {
              "t": "Adaptive Interviewing / 저항 유형에 따라 접근을 전환하는 ORBIT 계열 모형"
            },
            {
              "t": "Duration and Fatigue Effects / 장시간 면담이 진술 신뢰도에 미치는 영향"
            },
            {
              "t": "Coercion Threshold / 압박이 진술의 증거 가치를 파괴하는 경계"
            },
            {
              "t": "Rights and Admissibility / 고지·기록 요건이 진술의 효력을 결정하는 구조"
            },
            {
              "t": "Reid Technique / 고발적 9단계 심문 구조와 그 전제"
            },
            {
              "t": "Minimization and Maximization / 축소·과장 화법이 만드는 암묵적 형량 약속 (Kassin)"
            }
          ]
        },
        {
          "no": 12,
          "title": "Vulnerable Interviewees",
          "anchor": "12-vulnerable-interviewees",
          "subs": [],
          "items": [
            {
              "t": "Suggestibility Scale / 피암시성의 개인차를 측정하는 척도 (Gudjonsson)"
            },
            {
              "t": "Compliance vs Suggestibility / 순응과 피암시성의 구분과 각각의 위험"
            },
            {
              "t": "Minor Interview Protocol / 미성년 면담의 발달 단계별 제약"
            },
            {
              "t": "Intellectual Disability Safeguards / 지적장애 피면담자 보호 절차"
            },
            {
              "t": "Appropriate Adult / 제3자 입회 제도의 기능과 그 한계"
            },
            {
              "t": "Interpreter-mediated Interview / 통역 개입이 만드는 정보 손실과 왜곡"
            }
          ]
        },
        {
          "no": 13,
          "title": "False Confession",
          "anchor": "13-false-confession",
          "subs": [],
          "items": [
            {
              "t": "Voluntary False Confession / 외부 압력 없이 발생하는 허위자백 유형"
            },
            {
              "t": "Compliant False Confession / 상황 압력에 순응해 나오는 허위자백 (Kassin)"
            },
            {
              "t": "Internalized False Confession / 스스로 죄를 믿게 되는 내재화형 허위자백"
            },
            {
              "t": "Corroboration Inflation / 자백 이후 다른 증거가 자백에 맞춰 변형되는 현상"
            },
            {
              "t": "Exoneration Case Base / 무죄 확정 사례가 드러낸 면담 실패의 통계"
            }
          ]
        }
      ]
