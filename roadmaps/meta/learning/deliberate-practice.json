        {
          "no": 1,
          "title": "Target Selection",
          "anchor": "1-target-selection",
          "subs": [],
          "items": [
            {
              "t": "Skill Decomposition / 한 기술을 30분 안에 반복 가능한 하위 동작으로 분해"
            },
            {
              "t": "Weakness Isolation / 실패 지점만 뽑아 전용 드릴 만들기"
            },
            {
              "t": "Performance Metric / 드릴마다 숫자 지표 하나 붙여 매 세션 기록"
            },
            {
              "t": "Edge of Ability / 성공률 70~85% 구간이 되게 난이도 조정"
            }
          ]
        },
        {
          "no": 2,
          "title": "Feedback Loop",
          "anchor": "2-feedback-loop",
          "subs": [],
          "items": [
            {
              "t": "Immediate Feedback / 정오를 즉시 아는 채점 경로 확보"
            },
            {
              "t": "Error Log / 틀린 유형별로 세고 상위 3개만 다음 세션 과제로"
            },
            {
              "t": "Recording Review / 내 수행을 녹화·저장해 사후 관찰"
            },
            {
              "t": "Expert Comparison / 숙련자 수행과 내 것을 나란히 놓고 차이를 이름으로 적기"
            },
            {
              "t": "Coaching Substitute / 채점 기준표·리뷰 요청·자동 검증으로 코치를 대신하는 경로"
            }
          ]
        },
        {
          "no": 3,
          "title": "Mental Representation",
          "anchor": "3-mental-representation",
          "subs": [],
          "items": [
            {
              "t": "Chunking / 개별 동작이 한 덩어리로 자동화된 지점 표시"
            },
            {
              "t": "Pattern Vocabulary / 반복되는 상황 패턴에 이름 붙여 목록화"
            },
            {
              "t": "Anticipation Test / 다음 수를 먼저 적고 실제 전개와 대조"
            }
          ]
        },
        {
          "no": 4,
          "title": "Load and Plateau",
          "anchor": "4-load-and-plateau",
          "subs": [],
          "items": [
            {
              "t": "Plateau Diagnosis / 지표 정지 원인을 난이도·피드백·반복량으로 분리"
            },
            {
              "t": "Constraint Variation / 제약 하나 바꿔 같은 과제 재수행"
            },
            {
              "t": "Session Length / 집중이 유지되는 세션 길이 실측해 상한 고정"
            },
            {
              "t": "Effective Repetition Count / 누적 시간 대신 유효 반복 수로 기록"
            },
            {
              "t": "Ten Thousand Hour Claim / 시간 총량설의 원 논문과 통속 해석 차이 확인"
            }
          ]
        },
        {
          "no": 5,
          "title": "Skill Retention",
          "anchor": "5-skill-retention",
          "subs": [],
          "items": [
            {
              "t": "Spaced Skill Review / 안 쓰는 기술의 재수행 주기 정하기"
            },
            {
              "t": "Rust Check / 3개월 미사용 기술 재측정해 감소폭 기록"
            },
            {
              "t": "Transfer Test / 훈련하지 않은 변형 과제에서 성적 확인"
            }
          ]
        }
      ]
    }
