            {
              "t": "Work to Offload / 내 업무 목록에서 넘길 일을 골라 한 사람 몫으로 묶기"
            },
            {
              "t": "Job Description / 성과 기준까지 적힌 JD 한 편 써서 실제 게시"
            },
            {
              "t": "Compensation Range / 시장 시세를 조사해 급여 범위와 근거를 문서로 확정"
            },
            {
              "t": "Employment Form / 정규직, 계약직, 프리랜서 외주",
              "choice_inline": true
