      "sections": [
        {
          "no": 4,
          "title": "Producer",
          "anchor": "4-producer",
          "subs": [
            {
              "title": "Send Methods",
              "items": [
                {
                  "t": "Fire-and-forget / 응답을 기다리지 않고 보내는 방식"
                },
                {
                  "t": "Synchronous Send / 응답을 받을 때까지 기다리는 방식"
                },
                {
                  "t": "Asynchronous Send with Callback / 콜백으로 결과를 나중에 받는 방식"
                }
              ]
            },
            {
              "title": "Partitioning",
              "items": [
                {
                  "t": "Default Partitioner / 키 유무로 파티션을 정하는 기본 규칙"
                },
                {
                  "t": "Key-based Partitioning / 같은 키를 같은 파티션에 몰아주는 방식"
                },
                {
                  "t": "Sticky Partitioner / 키 없을 때 배치를 한 파티션에 묶는 방식"
                },
                {
                  "t": "Custom Partitioner / 파티션 배정 규칙을 직접 정하는 방법"
                }
              ]
            },
            {
              "title": "Key Configuration",
              "items": [
                {
                  "t": "Acknowledgements / acks 값으로 복제 확인 수준을 정하는 옵션"
                },
                {
                  "t": "Batching and Compression / batch.size·linger.ms로 묶어 압축하는 설정"
                },
                {
                  "t": "Retries and Timeouts / retries·delivery.timeout.ms로 재시도를 거는 설정"
                }
              ]
            },
            {
              "title": "Reliability",
              "items": [
                {
                  "t": "Idempotent Producer / 같은 레코드가 중복 저장되지 않게 막는 기능"
                },
                {
                  "t": "Ordering Guarantees / max.in.flight.requests로 순서를 지키는 조건"
                }
              ]
            }
          ],
          "items": []
        },
