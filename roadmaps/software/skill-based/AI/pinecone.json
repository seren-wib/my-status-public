                {
                  "t": "Pod Size and Replicas / 용량과 이중화 개수를 미리 정하는 값"
                },
                {
                  "t": "Collection / Pod 인덱스를 멈춘 채 저장하는 정적 스냅샷"
                }
              ]
            }
